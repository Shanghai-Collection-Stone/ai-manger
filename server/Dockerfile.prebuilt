# 只消费 CI 产物的运行时镜像: dist / public/pages 由 GitHub 托管 runner 编译好后下载而来.
# 服务器上不再跑 tsc 与 astro (tsc 峰值堆约 900MB, 小内存机器必然 OOM), 只装 prod 依赖并起容器.
# 编译型构建仍保留在 Dockerfile.pure, 供大内存机器一把梭使用.
FROM node:20-alpine AS prod-deps

WORKDIR /app

RUN npm i -g pnpm@10.34.5

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile

FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3011
ENV PATH=/usr/local/bin:$PATH

RUN npm i -g meitu-cli

COPY --from=prod-deps /app/node_modules ./node_modules
COPY dist ./dist
COPY src/modules/data-source/sources ./dist/modules/data-source/sources
COPY public ./public
COPY config ./config
COPY migrations ./migrations
COPY package.json ./package.json
COPY pnpm-lock.yaml ./pnpm-lock.yaml

# 产物缺失时立刻失败, 避免起一个空壳容器
RUN test -f dist/main.js || (echo "dist/main.js missing: CI artifact not downloaded" && exit 1)
RUN test -d public/pages || (echo "public/pages missing: web build artifact not downloaded" && exit 1)

RUN mkdir -p \
  public/uploads \
  public/uploads_thumbs \
  public/uploads_zips \
  data/cache \
  storage/mcp

EXPOSE 3011

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3011}/" >/dev/null || exit 1

CMD ["sh", "-lc", "AK=${MEITU_AK:-$OPEN_CLAW_AK}; SK=${MEITU_SK:-$OPEN_CLAW_SK}; if [ -n \"$AK\" ]; then meitu config set-ak --value \"$AK\"; fi; if [ -n \"$SK\" ]; then meitu config set-sk --value \"$SK\"; fi; if [ -z \"$MONGODB_URI\" ] && [ -n \"$MONGO_URI\" ]; then export MONGODB_URI=\"$MONGO_URI\"; fi; if [ -z \"$MONGODB_URI\" ] && [ -n \"$MONGO_URL\" ]; then export MONGODB_URI=\"$MONGO_URL\"; fi; if [ -z \"$MONGODB_URI\" ] && [ -n \"$MONGODB_URL\" ]; then export MONGODB_URI=\"$MONGODB_URL\"; fi; if [ -z \"$MONGODB_DB\" ] && [ -n \"$MONGO_DB_NAME\" ]; then export MONGODB_DB=\"$MONGO_DB_NAME\"; fi; if [ -z \"$MONGODB_DB\" ] && [ -n \"$MONGO_DB\" ]; then export MONGODB_DB=\"$MONGO_DB\"; fi; if [ -n \"$MONGODB_DOCKER_HOST\" ] && [ -n \"$MONGODB_URI\" ]; then export MONGODB_URI=\"$(printf '%s' \"$MONGODB_URI\" | sed \"s/127\\.0\\.0\\.1/$MONGODB_DOCKER_HOST/g; s/localhost/$MONGODB_DOCKER_HOST/g\")\"; fi; if [ -z \"$MONGODB_URI\" ]; then echo \"Warning: MONGODB_URI is empty (aliases: MONGO_URI/MONGO_URL/MONGODB_URL). App may fallback to localhost:27017.\"; fi; if [ -n \"$MONGODB_URI\" ] && [ -z \"$MONGODB_DOCKER_HOST\" ] && echo \"$MONGODB_URI\" | grep -E -q '://([^@/]*@)?(localhost|127\\.0\\.0\\.1)(:|/|$)'; then echo \"Warning: MONGODB_URI points to localhost/127.0.0.1 inside container. Use external host/IP, or set MONGODB_DOCKER_HOST.\"; fi; exec node dist/main.js"]
