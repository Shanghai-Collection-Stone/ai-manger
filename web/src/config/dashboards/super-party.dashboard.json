{
  "dashboardCode": "ai-commander",
  "version": 1,
  "title": "AI 指挥官看板 - 超级派对租户",
  "description": "为超级派对定制的看板配置",
  "timeRanges": ["今天", "本周", "本月"],
  "tabs": [
    {
      "id": "overview",
      "label": "总览",
      "layout": {
        "cols": 2,
        "gap": 16
      },
      "blocks": [
        {
          "id": "ai_progress",
          "type": "ai_progress",
          "layout": {
            "colSpan": 2,
            "rowSpan": 1
          },
          "props": {
            "title": "AI 覆盖达成率",
            "value": 85
          }
        },
        {
          "id": "revenue_card",
          "type": "revenue_overview_card",
          "query": "revenueOverview",
          "layout": {
            "colSpan": 2,
            "rowSpan": 1
          },
          "props": {
            "title": "场地营收",
            "unit": "万元"
          }
        },
        {
          "id": "people_pie",
          "type": "people_pie_card",
          "query": "peopleStats",
          "layout": {
            "colSpan": 1,
            "rowSpan": 1
          },
          "props": {
            "title": "客户分类"
          }
        },
        {
          "id": "channel_pie",
          "type": "demand_channel_pie_card",
          "query": "demandChannel",
          "layout": {
            "colSpan": 1,
            "rowSpan": 1
          },
          "props": {
            "title": "订单来源",
            "topN": 4
          }
        },
        {
          "id": "sales_top3",
          "type": "sales_ranking_inline",
          "query": "sales",
          "layout": {
            "colSpan": 2,
            "rowSpan": 1
          },
          "props": {
            "title": "员工排名 TOP 3",
            "topN": 3
          }
        }
      ]
    },
    {
      "id": "revenue",
      "label": "营收数据",
      "layout": {
        "cols": 2,
        "gap": 16
      },
      "blocks": [
        {
          "id": "revenue_main",
          "type": "revenue_overview_card",
          "query": "revenueOverview",
          "layout": {
            "colSpan": 2,
            "rowSpan": 1
          },
          "props": {
            "title": "场地营收",
            "unit": "万元"
          }
        },
        {
          "id": "daily_chart",
          "type": "daily_revenue_people_chart",
          "query": "dailyRevenue",
          "layout": {
            "colSpan": 2,
            "rowSpan": 1
          },
          "props": {
            "title": "日营收趋势",
            "height": 180
          }
        }
      ]
    }
  ]
}
